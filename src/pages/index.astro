---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Header from '../components/Header.astro';
import { certificates, experience, featuredProjects, process, projects, site, skills } from '../data/site';
---

<BaseLayout title={`${site.shortName} — ${site.role}`} description={site.description}>
  <Header />
  <main id="main-content">
    <section class="hero shell" id="top">
      <p class="eyebrow">Available for thoughtful engineering work</p>
      <h1>Backend systems with an <em>AI-native</em> point of view.</h1>
      <p class="hero-copy">{site.description} I work from the system underneath to the interface people use every day.</p>
      <div class="hero-actions">
        <a class="button primary" href="#work">View selected work <span>↘</span></a>
        <a class="button quiet" href="/Haider-Naqvi-Resume.pdf" download>Haider Naqvi Resume <span>↓</span></a>
        <a class="button quiet" href="#contact">Get in touch <span>→</span></a>
      </div>
      <div class="signal" aria-label="System signal visualization">
        <span></span><span></span><span></span><span></span><span></span>
        <p>DISCOVER <b>→</b> MODEL <b>→</b> BUILD <b>→</b> DELIVER</p>
      </div>
    </section>

    <section class="section shell" id="about">
      <div class="section-label">01 / ABOUT</div>
      <div class="prose"><p>I’m {site.shortName}, a {site.role} focused on practical systems: APIs, retrieval-augmented applications, asynchronous workflows, and the product surfaces that make them useful. I care about doing the difficult, unglamorous work properly—clear boundaries, durable data, useful automation, and an experience people can trust.</p><p>This portfolio is being assembled from verified project material. The goal is simple: show the thinking behind the work, not just a list of technologies.</p></div>
    </section>

    <section class="section shell" id="experience">
      <div class="section-label">02 / EXPERIENCE</div>
      <ol class="timeline">{experience.map((item) => <li><p class="period">{item.period}</p><div><h2>{item.role}</h2><p class="org">{item.organization}</p><p>{item.note}</p></div></li>)}</ol>
    </section>

    <section class="section shell" id="work">
      <div class="section-label">03 / SELECTED WORK</div>
      <div class="work-intro"><h2>Case studies, not a gallery of claims.</h2><p>Three systems selected for the quality of their engineering decisions, real operating context, and ability to show how I work.</p></div>
      <ol class="featured-projects">{featuredProjects.map((project, index) => <li><div class="featured-number">0{index + 1}</div><div><p class="eyebrow">{project.kind}</p><h3>{project.name}</h3><dl><div><dt>Problem</dt><dd>{project.problem}</dd></div><div><dt>System</dt><dd>{project.system}</dd></div><div><dt>Outcome</dt><dd>{project.outcome}</dd></div></dl><p class="featured-tech">{project.technologies}</p><a href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel={project.href.startsWith('http') ? 'noreferrer' : undefined}>{project.action} →</a></div></li>)}</ol>
    </section>

    <section class="section shell" id="other-projects">
      <div class="section-label">04 / OTHER PROJECTS</div>
      <div class="project-list">{projects.map((project) => <article><div><p class="eyebrow">{project.kind}</p><h2>{project.name}</h2><p>{project.summary}</p></div><div class="project-meta"><p>{project.technologies}</p><span>{project.state}</span><a href={project.href} target="_blank" rel="noreferrer">{'linkLabel' in project ? project.linkLabel : 'Repository'} ↗</a></div></article>)}</div>
    </section>

    <section class="section shell" id="process">
      <div class="section-label">05 / HOW I WORK</div>
      <ol class="process-list">{process.map(([number, title, description]) => <li><span>{number}</span><h2>{title}</h2><p>{description}</p></li>)}</ol>
    </section>

    <section class="section shell" id="skills">
      <div class="section-label">06 / CAPABILITIES</div>
      <div class="skills-grid">{skills.map(([group, list, note]) => <article><p class="eyebrow">{group}</p><h2>{list}</h2><p>{note}</p></article>)}</div>
    </section>

    <section class="section shell" id="certificates">
      <div class="section-label">07 / CERTIFICATES</div>
      <div class="certificate-list">{certificates.map(([title, issuer, details]) => <article><p class="eyebrow">{details}</p><h2>{title}</h2><p>{issuer}</p></article>)}</div>
    </section>

    <section class="section shell" id="writing">
      <div class="section-label">08 / WRITING</div>
      <div class="writing-intro"><h2>From decision to delivered system.</h2><p>Long-form case studies explain the problem, constraints, approach, architecture, important decisions, and result behind selected work.</p><a class="button quiet" href="/case-studies/">Browse case studies <span>→</span></a></div>
    </section>

    <section class="section shell" id="contact">
      <div class="section-label">09 / CONTACT</div>
      <div class="contact-grid"><div><h2>Let’s build something that holds up.</h2><p>For a role, a product problem, or a technically interesting conversation, reach me by email or WhatsApp.</p><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a><a class="contact-whatsapp" href={site.whatsapp} target="_blank" rel="noreferrer">WhatsApp: +92 313 6314125 ↗</a></div><ContactForm /></div>
    </section>
  </main>
  <footer class="shell footer"><p>© {new Date().getFullYear()} {site.shortName}</p><div><a href="/Haider-Naqvi-Resume.pdf" download>Resume</a><a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a><a href={site.links.github} target="_blank" rel="noreferrer">GitHub</a><a href="/privacy/">Privacy</a></div></footer>
</BaseLayout>
